+// Probe-only diagnostics. Logging must not change the transport's errno.
+template <typename... Args>
+void transport_log(const char *format, Args... args) noexcept
+{
+    const int saved_errno = errno;
+    if (FILE *log = std::fopen("/data/opengoal/elevation_transport.log", "a"))
+    {
+        std::fprintf(log, format, args...);
+        std::fputc('\n', log);
+        (void)std::fclose(log);
+    }
+    errno = saved_errno;
