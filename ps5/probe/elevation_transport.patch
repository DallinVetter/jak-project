+bool send_all(int socket, const void *data, std::size_t size,
+              const char *phase, std::size_t *streamed_bytes = nullptr) noexcept
+{
+    const bool sent = elevation::wire::transfer(
+        static_cast<const std::uint8_t *>(data), size,
+        [socket, phase, streamed_bytes](const auto *bytes, std::size_t remaining)
+        {
+            const int count = sceNetSend(socket, bytes, remaining, 0);
+            transport_log("%s sceNetSend requested=%zu result=%d errno=%d",
+                          phase, remaining, count, errno);
+            if (streamed_bytes && count > 0 && static_cast<std::size_t>(count) <= remaining)
+                *streamed_bytes += static_cast<std::size_t>(count);
+            return count;
+        });
+    transport_log("%s send_all bytes=%zu result=%d errno=%d", phase, size, sent, errno);
+    return sent;
+}
+
+bool receive(int socket, elevation::wire::Message &message, const char *phase) noexcept
+{
+    const bool received = elevation::wire::transfer(
+        reinterpret_cast<std::uint8_t *>(&message), sizeof(message),
+        [socket, phase](auto *bytes, std::size_t remaining)
+        {
+            const int count = sceNetRecv(socket, bytes, remaining, 0);
+            transport_log("%s sceNetRecv requested=%zu result=%d errno=%d",
+                          phase, remaining, count, errno);
+            return count;
+        });
+    transport_log("%s receive result=%d errno=%d", phase, received, errno);
+    return received;
 }

